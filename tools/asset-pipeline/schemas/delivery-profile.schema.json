{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gummybears.local/schemas/delivery-profile.schema.json",
  "title": "Gummy Bears asset delivery profile",
  "type": "object",
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "description",
    "scope",
    "materials",
    "texel_density",
    "web_delivery",
    "verification",
    "limits",
    "deferred"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "status": {
      "enum": ["draft", "provisional", "active", "deprecated"]
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "scope": {
      "type": "object",
      "required": ["asset_types", "first_target"],
      "properties": {
        "asset_types": {"type": "array", "items": {"type": "string"}},
        "usage": {"type": "array", "items": {"type": "string"}},
        "first_target": {"type": "string"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true
    },
    "materials": {
      "type": "object",
      "required": ["model"],
      "properties": {
        "model": {"type": "string"},
        "required_channels": {"type": "array", "items": {"type": "string"}},
        "optional_channels": {"type": "array", "items": {"type": "string"}},
        "alpha": {"type": "string"},
        "double_sided": {},
        "extensions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "textures": {
      "type": "object",
      "additionalProperties": true
    },
    "texel_density": {
      "type": "object",
      "required": [
        "method",
        "camera",
        "viewport_px",
        "texture_resolutions_px",
        "target_texels_per_screen_pixel",
        "spread_ratio_max",
        "anisotropy_ratio_max",
        "zone_mode",
        "small_triangle_screen_px",
        "min_zone_samples",
        "min_visible_fraction",
        "advisory",
        "notes"
      ],
      "properties": {
        "method": {"const": "camera_projected_advisory"},
        "camera": {"type": ["string", "null"]},
        "viewport_px": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "minItems": 2,
          "maxItems": 2
        },
        "texture_resolutions_px": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "items": {"type": "integer", "minimum": 1},
            "minItems": 2,
            "maxItems": 2
          }
        },
        "target_texels_per_screen_pixel": {
          "type": "array",
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 2,
          "maxItems": 2
        },
        "spread_ratio_max": {"type": "number", "exclusiveMinimum": 0},
        "anisotropy_ratio_max": {"type": "number", "minimum": 1},
        "zone_mode": {"enum": ["material", "object"]},
        "small_triangle_screen_px": {"type": "number", "minimum": 0},
        "min_zone_samples": {"type": "integer", "minimum": 1},
        "min_visible_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "advisory": {"type": "boolean"},
        "notes": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "web_delivery": {
      "type": "object",
      "required": ["format", "compression", "report"],
      "properties": {
        "format": {"type": "string"},
        "compression": {"type": "object", "additionalProperties": true},
        "report": {"type": "array", "items": {"type": "string"}},
        "required_extensions": {"type": "array", "items": {"type": "string"}},
        "loader_changes": {"type": "string"}
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["structural", "visual", "performance", "evidence"],
      "properties": {
        "structural": {"type": "array", "items": {"type": "string"}},
        "visual": {"type": "array", "items": {"type": "string"}},
        "performance": {"type": "array", "items": {"type": "string"}},
        "evidence": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "limits": {"type": "array", "items": {"type": "string"}},
    "deferred": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
