{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gummybears.local/schemas/verification-report.schema.json",
  "title": "Gummy Bears asset verification report",
  "type": "object",
  "required": [
    "schema_version",
    "tool",
    "generated_at",
    "asset",
    "sections",
    "captures",
    "findings",
    "disposition",
    "limits",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": true
    },
    "generated_at": {"type": "string"},
    "asset": {
      "type": "object",
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0},
        "profile": {"type": ["object", "null"]},
        "manifest": {"type": ["object", "null"]},
        "provenance": {"type": ["object", "null"]},
        "visual_review": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "sections": {
      "type": "object",
      "required": [
        "identity",
        "structure",
        "validator",
        "dependencies",
        "clean_import",
        "preview",
        "visual",
        "resources"
      ],
      "additionalProperties": {"$ref": "#/$defs/section"}
    },
    "captures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "view", "light"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "view": {"type": "string"},
          "light": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "disposition": {
      "type": "object",
      "required": ["status", "reasons"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "limits": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "status": {
      "enum": ["pass", "review", "fail", "unverified", "not_run"]
    },
    "finding": {
      "type": "object",
      "required": ["severity", "code", "message"],
      "properties": {
        "severity": {"enum": ["error", "warning", "info"]},
        "code": {"type": "string"},
        "message": {"type": "string"},
        "section": {"type": "string"}
      },
      "additionalProperties": true
    },
    "section": {
      "type": "object",
      "required": ["status", "findings", "evidence", "details"],
      "properties": {
        "status": {"$ref": "#/$defs/status"},
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/finding"}
        },
        "evidence": {"type": "array", "items": {"type": "string"}},
        "details": {"type": "object"}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
