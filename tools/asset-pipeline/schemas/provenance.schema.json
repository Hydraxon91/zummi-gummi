{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gummybears.local/schemas/provenance.schema.json",
  "title": "Gummy Bears asset provenance record",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "source",
    "tool",
    "created_at",
    "status",
    "generation",
    "processing",
    "export",
    "verification"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "asset_id": {"type": ["string", "null"]},
    "source": {
      "type": "object",
      "required": ["path", "sha256", "is_dirty", "units", "axes"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "is_dirty": {"type": "boolean"},
        "units": {"type": "string"},
        "axes": {"type": "string"},
        "author": {"type": ["string", "null"]},
        "licence": {"type": ["string", "null"]},
        "reference_rights": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string"},
        "version": {"type": "string"},
        "blender_version": {"type": "string"},
        "helper_versions": {"type": "object", "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "created_at": {"type": "string"},
    "status": {
      "enum": ["audit_only", "in_progress", "verified", "rejected"]
    },
    "generation": {
      "type": ["object", "null"],
      "properties": {
        "model": {"type": ["string", "null"]},
        "unet": {"type": ["string", "null"]},
        "text_encoder": {"type": ["string", "null"]},
        "workflow_hash": {"type": ["string", "null"]},
        "prompt": {"type": ["string", "null"]},
        "negative_prompt": {"type": ["string", "null"]},
        "seed": {"type": ["integer", "null"]},
        "steps": {"type": ["integer", "null"]},
        "cfg": {"type": ["number", "null"]},
        "sampler": {"type": ["string", "null"]},
        "scheduler": {"type": ["string", "null"]},
        "resolution": {"type": ["array", "null"], "items": {"type": "integer"}},
        "references": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
        "duration_seconds": {"type": ["number", "null"]}
      },
      "additionalProperties": true
    },
    "processing": {
      "type": "object",
      "properties": {
        "blender_version": {"type": ["string", "null"]},
        "operations": {"type": "array", "items": {"type": "string"}},
        "bake_settings": {"type": ["object", "null"], "additionalProperties": true}
      },
      "additionalProperties": true
    },
    "export": {
      "type": "object",
      "required": ["path", "sha256", "size_bytes", "format", "validator"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "size_bytes": {"type": ["integer", "null"]},
        "format": {"type": "string"},
        "extensions": {"type": "array", "items": {"type": "string"}},
        "validator": {
          "type": "object",
          "properties": {
            "name": {"type": "string"},
            "version": {"type": ["string", "null"]},
            "errors": {"type": "integer"},
            "warnings": {"type": "integer"},
            "hints": {"type": "integer"},
            "report": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "verification": {
      "type": "object",
      "required": ["status", "evidence", "warnings", "limitations"],
      "properties": {
        "status": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
