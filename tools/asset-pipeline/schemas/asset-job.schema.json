{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Asset pipeline job",
  "type": "object",
  "required": ["out_dir"],
  "properties": {
    "name": {"type": "string"},
    "source": {"type": "string", "description": "Optional .blend to open before running"},
    "objects": {"type": "array", "minItems": 1, "items": {"type": "string"},
                "description": "Root object names; empties expand to children"},
    "exclude": {"type": "array", "items": {"type": "string"}},
    "out_dir": {"type": "string"},
    "profile": {"enum": ["prop", "mixed", "architectural"]},
    "require_closed": {"type": "boolean"},
    "uv_layer": {"type": "string", "default": "AtlasUV"},
    "unwrap": {"type": "boolean"},
    "unwrap_margin": {"type": "number", "default": 0.02},
    "resolution": {"type": ["integer", "array"], "minimum": 64, "maximum": 8192},
    "margin": {"type": "integer", "minimum": 0, "maximum": 64, "default": 8},
    "samples": {"type": "integer", "minimum": 1, "maximum": 512},
    "alpha": {"type": "boolean", "default": true},
    "export": {"type": ["string", "boolean"], "description": "false disables delivery export"},
    "gate": {"type": "object"},
    "preset": {"enum": ["solid", "material", "final"]},
    "isolate": {"type": "boolean"},
    "frame": {"type": "integer"},
    "pose_object": {"type": "string"},
    "blend": {"type": "string"},
    "glb": {"type": "string"},
    "views": {"type": "string", "description": "Comma-separated view names"},
    "engine": {"type": "string"},
    "subdir": {"type": "string"}
  },
  "additionalProperties": true
}
